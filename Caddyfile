### SITES

# deltaryz.com
# This won't work unless the deltaryz.com folder is owned by root:root
deltaryz.com {
    tls mail@deltaryz.com
    root /srv/deltaryz.com
    gzip

    git {
        repo https://github.com/deltaryz/deltaryz.com
        branch main
        interval 1200
        clone_args --depth 1
        pull_args --force
    }

    proxy /yt-next http://stream-update:3001 {
        transparent
        websocket
    }
}

# blog.deltaryz.com
# This won't work unless the blog.deltaryz.com folder is owned by root:root
blog.deltaryz.com {
    tls mail@deltaryz.com
    root /srv/blog.deltaryz.com
    gzip

    git {
        repo https://github.com/deltaryz/blog
        branch main
        interval 1200
        clone_args --depth 1
        pull_args --force
        then sh /srv/blog.deltaryz.com/update.sh
    }
}

# pvfm.deltaryz.com (PVFM App)
# Be careful with this one, a google play app depends on it
# This won't work unless the pvfm.deltaryz.com folder is owned by root:root
pvfm.deltaryz.com {
    tls mail@deltaryz.com
    root /srv/pvfm.deltaryz.com
    gzip

    header / {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    git {
        repo https://github.com/deltaryz/pvfm
        branch main
        interval 1200
        clone_args --depth 1
        pull_args --force
    }

    # metadata proxy: PVFM stopped sending Access-Control-Allow-Origin, so the
    # app's two metadata calls come from /data/* on this host instead of
    # ponyvillefm.com. Same origin, so CORS no longer applies. Streams and
    # artwork stay direct -- plain <audio>/<img> loads were never gated.
    # pvfm-proxy in docker-compose.yml
    proxy /data/ http://pvfm-proxy:8080

    # Request log with NO identifiers (deltaryz, 2026-11-09). Caddy v1 cannot
    # take a custom format on a site-level log block ("format" is rejected there
    # -- wrong argument count), so this is the default common format with
    # `ipmask 0.0.0.0`: the client address is masked to 0.0.0.0, leaving only
    # timestamp, method, path and status. Verified: masks to 0.0.0.0, not to a
    # /0 mask that keeps everything. That is no personal data, so keeping it is
    # fine and it is the only place abuse shows up now that the container runs
    # with logging driver "none" (the error log, which DOES print client IPs on
    # TLS handshake failures, is therefore stored nowhere).
    # Query strings pass through as sent -- the app's calls carry none.
    log /logs/pvfm-access.log {
        ipmask 0.0.0.0
        rotate_size 4
        rotate_keep 2
        rotate_age 7
    }
}


# dev.paws-on.me (browser VS Code -- the code-server container, on dockernet)
# HTTPS comes from ACME; the auth is basic auth here, not in code-server, because
# code-server has no usernames and this way there is exactly one prompt.
# The container publishes no host port, so this vhost is the only door.
dev.paws-on.me {
    tls mail@deltaryz.com
    # NO basicauth here on purpose. HTTP basic auth is a browser dialog, not a
    # form: iOS Safari neither autofills nor saves it, and the WebSocket handshake
    # re-prompts, which loops the workbench. The login lives in code-server
    # itself instead (a real form, session cookie, saveable in the password
    # manager). If basic auth is ever wanted back, it goes in Caddyfile.local --
    # caddy 1.0.3 only accepts PLAINTEXT there, a bcrypt hash 401s always.
    proxy / http://code-server:8443 {
        websocket
        transparent
    }
}

# floof.zone
floof.zone {
    tls mail@deltaryz.com
    root /srv/floof.zone
    gzip

    # running on atybox
    redir /files /files/ 301
    proxy /files/ http://100.111.32.61:5678 {
        without /files
    }

    proxy /gb http://100.103.147.17:5999 {
        without /gb
    }
}

