# Jellyfin (video/media server)
watch.deltaryz.com {
    tls mail@deltaryz.com
    gzip

    # jellyfin moved with the array: doritobox -> cheetobox (2026-10-31)
    proxy / http://100.118.149.5:8096 {
        transparent
        websocket
    }
}

# transfer.sh (file sharing)
share.deltaryz.com {
    tls mail@deltaryz.com
    gzip

    # running on atybox
    proxy / http://100.111.32.61:8734 {
        header_upstream Host "share.deltaryz.com"
        header_upstream X-Forwarded-Proto "https"
    }
}

