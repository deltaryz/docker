# Horse Power proxy (server runs in other container)
horsepower.deltaryz.com {
    tls mail@deltaryz.com

    # horsepower in docker-compose.yml
    proxy / http://horsepower:7499 {
        header_upstream Cross-Origin-Opener-Policy "same-origin"
        header_upstream Cross-Origin-Embedder-Policy "require-corp"
    }
}

# pupcircuit.floof.zone (Circuit's Navidrome)
# The service container publishes 50420 on atybox; Navidrome runs with baseurl=/ so
# no path rewriting is needed -- this is proxied at the root, unlike paws-on.me's
# /api/ routes which strip their prefix.
pupcircuit.floof.zone {
    tls mail@deltaryz.com
    gzip

    proxy / http://100.111.32.61:50420 {
        transparent
        websocket
    }
}
